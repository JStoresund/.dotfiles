[user]
	name = Johan
	email = johanstore2002@gmail.com
	signingkey = ~/.ssh/id_ed25519_signing.pub

[core]
	sshCommand = ssh -v

[url "ssh://git@github.com/"]
        insteadOf = https://github.com/
[gpg]
	format = ssh
[commit]
	gpgsign = true
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers
